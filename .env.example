# Connection to the Gewerber backend (Serverpod API).
GEWERBER_MCP_API_URL=http://localhost:8080

# Credentials of an admin/moderator account.
# The global role comes from the backend `admin_user` allowlist — grant it with
# gewerber_backend_server/tool/grant_admin.sql (out of band, by design).
GEWERBER_MCP_EMAIL=admin@example.com
GEWERBER_MCP_PASSWORD=change-me

# Optional: name reported to the MCP client during initialization.
#GEWERBER_MCP_SERVER_NAME=gewerber-admin

# Optional: set to "true" to log every tool call to stderr
# (stdout carries the MCP protocol and must stay clean).
#GEWERBER_MCP_LOG_TOOLS=true
